# Copie ce fichier en .env.local et remplis les valeurs.

# Longue chaîne aléatoire servant à signer les cookies de session.
# Exemple pour en générer une (PowerShell) :
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Code de connexion du MJ (utilisé uniquement à la création de data/db.json).
ADMIN_CODE=chaiselongue21

# Mettre à false si tu sers le site en production en HTTP simple (ex: réseau local),
# sinon le navigateur refusera le cookie de session.
# COOKIE_SECURE=false
